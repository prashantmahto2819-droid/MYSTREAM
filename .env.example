# ---------- required ----------
# Long random string. Stream keys are encrypted with it - if you change it, saved keys become unreadable.
# Generate: openssl rand -hex 32
APP_SECRET=

# What OBS users type as "Server" (the stream key is shown in the dashboard).
# Use a DNS-only (grey cloud) Cloudflare record for this host - Cloudflare's proxy does not carry RTMP.
PUBLIC_RTMP_URL=rtmp://rtmp.example.com/live

# First admin account, created only when the database has no users yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Where database + videos + recordings are stored on the server (default ./data).
# Point it to a Hetzner Volume to get more disk, e.g. /mnt/HC_Volume_12345678/vivid-stream
# DATA_PATH=

# ---------- WhatsApp alerts (optional, can be filled later) ----------
# Any HTTP endpoint that sends a message. For Vivid Relay: its "send message" URL.
# ALERT_WEBHOOK_URL=https://relay.vividbrandify.com/api/send
# Value of the Authorization header, if the endpoint needs one (e.g. "Bearer abc123").
# ALERT_WEBHOOK_AUTH=
# JSON body. {{to}} and {{message}} are replaced. Change the field names to match the endpoint.
# ALERT_BODY_TEMPLATE={"to":"{{to}}","message":"{{message}}"}
# Office numbers that get EVERY alert, comma separated, with country code and no +.
# ALERT_TO=919876543210,919812345678
# Same alert for the same destination is not repeated within this many minutes.
# ALERT_COOLDOWN_MINUTES=5

# ---------- limits (optional) ----------
# MAX_DESTINATIONS=10        per user
# MAX_UPLOAD_GB=20           largest single video
# USER_QUOTA_GB=30           stored videos per user
# DISK_RESERVE_GB=3          uploads are refused if less than this would stay free
# LATE_START_MINUTES=10      a schedule older than this when the server comes back is marked "missed"
